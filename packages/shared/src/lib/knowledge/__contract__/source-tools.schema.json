          },
          "revisionId": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "contentHash": {
            "type": "string"
          }
        },
        "required": ["outcome", "sourceId", "revisionId", "jobId", "contentHash"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "const": "stale"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "currentRevisionId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["outcome", "sourceId", "currentRevisionId"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "const": "conflict"
          },
          "sourceId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "currentRevisionId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["outcome", "sourceId", "currentRevisionId"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "const": "retracted"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["outcome", "sourceId"],
        "additionalProperties": false
      }
    ]
  },

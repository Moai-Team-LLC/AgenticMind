{
  "kl_upsert_source.input": {
    "type": "object",
    "properties": {
      "source": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "externalId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "connectionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "knowledgeType": {
            "type": "string",
            "enum": ["canonical", "evidence", "inference"]
          },
          "language": {
            "type": "string",
            "enum": [
              "simple",
              "arabic",
              "danish",
              "dutch",
              "english",
              "finnish",
              "french",
              "german",
              "indonesian",
              "italian",
              "norwegian",
              "portuguese",
              "russian",
              "spanish",
              "swedish",
              "turkish"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": ["workspace", "restricted", "personal"]
          },
          "recipients": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": ["sourceType", "externalId"],
        "additionalProperties": false
      },
      "revision": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "segments": {
            "maxItems": 5000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "speaker": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "speakerId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "startMs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "endMs": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          },
          "externalVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "commitSha": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,64}$"
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "environment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "additionalProperties": false
          },
          "warnings": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "additionalProperties": false
      },
      "expectedRevisionId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "allowResurrect": {
        "type": "boolean"
      }
    },
    "required": ["source", "revision"],
    "additionalProperties": false
  },
  "kl_upsert_source.output": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
